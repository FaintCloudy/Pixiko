<?xml version="1.0" encoding="utf-8"?>
<!--
  服务器设置页：
  - 上方是「新增服务器」卡片：地址、令牌、测试连接、扫描局域网；
  - 下方是已保存的服务器列表（运行期用代码往 server_list 里加卡片，不需要 RecyclerView 依赖）。

  地址/令牌输入框都设了 importantForAutofill=no：局域网 IP 被密码管理器/自动填充插错值很难排查。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pixiko_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/pixiko_bar"
            app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
            app:title="@string/settings_title"
            app:titleTextColor="@color/pixiko_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_edit_title"
            android:textColor="@color/pixiko_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_edit_hint"
            android:textColor="@color/pixiko_muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/field_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints="none"
            android:hint="@string/settings_name"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/pixiko_text"
            android:textColorHint="@color/pixiko_muted" />

        <EditText
            android:id="@+id/field_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:autofillHints="none"
            android:hint="@string/settings_address"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/pixiko_text"
            android:textColorHint="@color/pixiko_muted" />

        <!-- 构建时烧进去的测试地址提示：只有「包里真的带了 BuildConfig.PIXIKO_DEFAULT_HOST」
             且是首次运行（还没保存过服务器）时才由 SettingsActivity 显示出来；
             -NoDefaultHost 构建出来的包里它永远是 gone（=旧行为）。 -->
        <TextView
            android:id="@+id/build_host_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/pixiko_accent"
            android:textSize="12sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/field_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:autofillHints="none"
            android:hint="@string/settings_token"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/pixiko_text"
            android:textColorHint="@color/pixiko_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/action_test"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_test" />

            <Button
                android:id="@+id/action_scan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/settings_scan" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/field_active"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="@string/settings_set_active"
            android:textColor="@color/pixiko_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/action_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_save" />

            <Button
                android:id="@+id/action_cancel_edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/settings_reset" />
        </LinearLayout>

        <!-- 测试/扫描的结果就地显示在这里（原生 Toast 一闪而过，长文案看不完）。 -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/pixiko_text"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/scan_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:indeterminate="false"
            android:max="100"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/pixiko_divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_saved_title"
            android:textColor="@color/pixiko_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/server_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/server_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_empty"
            android:textColor="@color/pixiko_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/settings_security_note"
            android:textColor="@color/pixiko_muted"
            android:textSize="12sp" />

        <!-- ==================== 应用更新 ==================== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/pixiko_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_update_title"
                android:textColor="@color/pixiko_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- 设置页的红点：有新版本时才亮（明显但不打断）。 -->
            <TextView
                android:id="@+id/update_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/pixiko_danger"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="@string/settings_update_badge"
                android:textColor="@color/pixiko_text"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/update_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/pixiko_muted"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/update_auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:checked="true"
            android:text="@string/settings_update_auto"
            android:textColor="@color/pixiko_text" />

        <!-- ============ 一键更新：显眼位置（就在「检查更新」上面），文案由 UpdateUiState 状态机决定 ============
             它和横幅上那个按钮同源（同一份 UpdateInfo / UpdatePrefs，同一个状态机），所以两处不会各说各话。
             文案随状态变：已是最新版本 / 更新到 1.6.2 / 下载中 37% / 安装 1.6.2 / 重试更新。 -->
        <Button
            android:id="@+id/update_oneclick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_oneclick_unchecked"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/update_oneclick_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_oneclick_boundary"
            android:textColor="@color/pixiko_muted"
            android:textSize="11sp" />

        <Button
            android:id="@+id/update_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_update_check" />

        <!-- 更新包下载进度（百分比由 Content-Length 算出）。 -->
        <ProgressBar
            android:id="@+id/update_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="false"
            android:max="100"
            android:visibility="gone" />

        <!-- 有新版本时才显示：新版本号 / 字节大小 / 渠道（开发还是正式）/ 更新说明 -->
        <TextView
            android:id="@+id/update_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/pixiko_accent"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/update_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/update_download"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_update_download" />

            <Button
                android:id="@+id/update_release_page"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/settings_update_release_page"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 更新流程的状态/结果（下载、校验、安装、失败原因都写在这）。 -->
        <TextView
            android:id="@+id/update_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/pixiko_text"
            android:textSize="13sp" />

        <!-- **必须保留**：这条把「自我更新能做到哪一步」讲清楚，不许改成含糊说法。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/settings_update_boundary"
            android:textColor="@color/pixiko_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
