<?xml version="1.0" encoding="utf-8"?>
<!--
  服务器设置页：
  - 上方是「新增服务器」卡片：地址、令牌、测试连接、扫描局域网；
  - 下方是已保存的服务器列表（运行期用代码往 server_list 里加卡片，不需要 RecyclerView 依赖）。

  地址/令牌输入框都设了 importantForAutofill=no：局域网 IP 被密码管理器/自动填充插错值很难排查。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pixiko_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/pixiko_bar"
            app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
            app:title="@string/settings_title"
            app:titleTextColor="@color/pixiko_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_edit_title"
            android:textColor="@color/pixiko_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_edit_hint"
            android:textColor="@color/pixiko_muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/field_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints="none"
            android:hint="@string/settings_name"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/pixiko_text"
            android:textColorHint="@color/pixiko_muted" />

        <EditText
            android:id="@+id/field_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:autofillHints="none"
            android:hint="@string/settings_address"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/pixiko_text"
            android:textColorHint="@color/pixiko_muted" />

        <!-- 构建时烧进去的测试地址提示：只有「包里真的带了 BuildConfig.PIXIKO_DEFAULT_HOST」
             且是首次运行（还没保存过服务器）时才由 SettingsActivity 显示出来；
             -NoDefaultHost 构建出来的包里它永远是 gone（=旧行为）。 -->
        <TextView
            android:id="@+id/build_host_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/pixiko_accent"
            android:textSize="12sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/field_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:autofillHints="none"
            android:hint="@string/settings_token"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/pixiko_text"
            android:textColorHint="@color/pixiko_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/action_test"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_test" />

            <Button
                android:id="@+id/action_scan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/settings_scan" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/field_active"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="@string/settings_set_active"
            android:textColor="@color/pixiko_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/action_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_save" />

            <Button
                android:id="@+id/action_cancel_edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/settings_reset" />
        </LinearLayout>

        <!-- 测试/扫描的结果就地显示在这里（原生 Toast 一闪而过，长文案看不完）。 -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/pixiko_text"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/scan_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:indeterminate="false"
            android:max="100"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/pixiko_divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_saved_title"
            android:textColor="@color/pixiko_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/server_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/server_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_empty"
            android:textColor="@color/pixiko_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/settings_security_note"
            android:textColor="@color/pixiko_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
