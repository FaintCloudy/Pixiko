# ---------------------------------------------------------------------------
# Pixiko — .gitignore
#
# 这个仓库的实际用途：**在笔记本和台式机之间同步进度**。
# 所以取舍标准是「换台机器能不能接着干」，不是「能不能给别人从 0 部署」：
#   · 要同步的：源码、脚本、文档、词库、语料、地图、以及**运行期状态**
#     （提示词、样式、参数预设、功能集、好感度/情绪、队列、人设……）
#   · 不同步的：能从别处重新生成的（build/、依赖 jar、node_modules）、
#     体积巨大的（生成图、测试临时目录）、随时会变的噪声（日志、备份）。
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- 本机配置
# config.json：含 owner QQ、Civitai Cookie、NapCat 令牌、网页访问令牌。
# ⚠ 仓库是公开的：一旦提交就等于把 DeepSeek 额度、Civitai 会话、控制台登录权公开。
#   想连它一起同步，先把仓库设为 private，再把下面这行注释掉。
config.json

# ---------------------------------------------------------------- 运行期状态
# 采用「白名单」写法：/data/* 先全部排除，再把要同步的逐个放行。
# 这样新增的运行期文件默认不进库，想同步时必须显式加一行——避免误传个人内容。
/data/*

# ① 词库与词表（随仓库分发，见 THIRD-PARTY-LICENSES.md）
!/data/prompt-tags.txt
!/data/prompt-tags.source.json
!/data/prompt-usage.json
!/data/prompt-zh-tags.json
!/data/prompt-zh-extra.txt
!/data/prompt-zh-usage.md
!/data/prompt-zh-use-notes.txt
!/data/danbooru/

# ② 《Rewrite》原作对白语料（第三方版权，作者要求随仓库分发，权利人要求即删）
!/data/kotori-corpus.txt

# ③ 非敏感的运行期状态（要同步：换台机器接着干）
#    注意：gitignore 的规则行末尾**不能写注释**，注释必须单独一行，否则整行变成匹配模式。
#    人设文本
!/data/chat-personality-kotori.txt
#    样式名与来源链接
!/data/civitai-style-links.json
#    词条中文释义缓存
!/data/prompt-meanings.json
#    上一次拉起 NapCat 的时间戳
!/data/napcat-last-start.txt
#    聊天提示词（每次聊天自动导出：实际发给 DeepSeek 的那份请求）
!/data/chat-prompt.txt
#    步数 / CFG / 种子 / 底模
!/data/sd-parameters.json
#    参数预设
!/data/sd-presets.json
#    采样方法 / 尺寸
!/data/sd-settings.json

# ④ 明确**不同步**（2026-09-27 由作者决定）：
#    · /data/prompts/          个人 prompt（含露骨内容）、文件名是群成员 QQ 号
#    · /data/local-styles.json 样式库正文（含露骨 prompt）
#    · /data/sd-state.json / sd-prompt-previous.json / sd-latest.json  当前与上一次的 prompt
#    · /data/sd-outbox.json    待领取队列（引用没同步的生成图，过去也是悬空路径）
#    · /data/sd-functions.json 功能集定义（含露骨 prompt）
#    · /data/affinity.json / mood.json  键是群号，属他人标识
#    · /data/deepseek-*.txt    DeepSeek 密钥
#    · /data/bot.lock          运行期锁
#    · /data/generated/        生成图（本机 10 GB，不进 git）
/data/prompts/
/data/local-styles.json
/data/sd-state.json
/data/sd-prompt-previous.json
/data/sd-latest.json
/data/sd-outbox.json
/data/sd-functions.json
/data/affinity.json
/data/mood.json
/data/chat-prompt-full.txt
/data/deepseek-api-key.txt
/data/deepseek-chat-api-key.txt
/data/*-api-key.txt
/data/bot.lock
/data/generated/

# ---------------------------------------------------------------- 地图（要同步）
# 地图图片随仓库分发（.yh / .liv 开箱可用）：换成自己的图就覆盖 maps/yh、maps/liv 里的文件。

# ---------------------------------------------------------------- 不同步：开发脚本 work/
# work/ 是测试临时目录与探针脚本的大杂烩（本机 91,000 个文件 / 36 GB），而且探针脚本里
# **硬编码了控制台访问令牌**（`loriko2026`，约 35 个文件），公开仓库不能带它。
# 需要同步脚本的话，先把令牌改成 `--token` 参数或环境变量 PIXIKO_WEBUI_TOKEN，再来放行。
/work/

# ---------------------------------------------------------------- 不同步：日志 / 备份 / 构建产物
/logs/
/backup/
/build/
/logs/**
/backup/**

# ---------------------------------------------------------------- 不同步：可再生成的依赖
lib/*.jar
lib/spring/
*.jar
*.class
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
nextjs-wip/.next/
nextjs-wip/out/

# ---------------------------------------------------------------- 不同步：噪声与临时文件
*.log
*.jsonl
*.zip
*.7z
*.tmp
*.bak
*.pixiko.bak
*.orig
*.rej

# ---------------------------------------------------------------- 不同步：F:\Bot 根目录的 Next.js 残留
# 那次重构的代码已经在 nextjs-wip/ 里留档，根目录这几份是过期的开发树，别跟着同步。
/app/
/components/
/public/
/tests/
/server.mjs
/package.json
/package-lock.json
/next.config.ts
/tsconfig.json
/instrumentation.ts
/build-next.bat
/run-next.bat
/test-next.bat
/stop-next.ps1

# ---------------------------------------------------------------- 密钥 / 环境变量
*-api-key.txt
*.key
.env
.env.*

# ---------------------------------------------------------------- 编辑器 / 系统
.vscode/
.idea/
*.iml
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# 只保留示例配置：显式放行（防止将来有人用 config* 通配把示例也挡掉）
!config.example.json
